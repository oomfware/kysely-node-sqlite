{
	"name": "@oomfware/kysely-node-sqlite",
	"version": "0.0.0",
	"description": "Kysely dialect for node:sqlite",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/kysely-node-sqlite"
	},
	"files": [
		"dist/",
		"src/",
		"!src/**/*.bench.ts",
		"!src/**/*.test.ts"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"test": "node --test src/**/*.test.ts",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "^25.3.2",
		"bumpp": "^10.4.1",
		"kysely": "^0.28.0",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"kysely": "^0.28.0"
	}
}
